# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Featherless.ai (server-side only, never NEXT_PUBLIC_) ----
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Use an UNGATED model. Gated repos (e.g. meta-llama/*) return 403 from Featherless
# unless your Featherless account is linked to a verified Hugging Face account.
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_MODEL_FALLBACK=mistralai/Mistral-7B-Instruct-v0.3

# ---- Policy flags ----
AUTO_DISPATCH_ENABLED=false
